# Основные настройки
PORT=3000
PUBLIC_BASE_URL=http://10.27.26.27:3000

# Для HTTPS укажите адрес https:// и включите защищённые cookie.
# Сам TLS должен завершаться на корпоративном reverse proxy.
SESSION_COOKIE_SECURE=false
TRUST_PROXY=false
# Альтернатива reverse proxy — прямой TLS в Node.js:
# TLS_CERT_PATH=/app/certs/portfolio.crt
# TLS_KEY_PATH=/app/certs/portfolio.key

# Active Directory по умолчанию выключен. Включайте только рабочий AD
# с доверенным сертификатом и ограниченной группой пользователей.
AD_ENABLED=false
AD_URL=ldaps://ad.company.local:636
AD_DOMAIN=company.local
AD_ADMIN_GROUP=Portfolio_Admins
AD_ALLOWED_GROUPS=Portfolio_Admins,Portfolio_Managers
AD_DEFAULT_ROLE=department_head
AD_ALLOW_LOCAL_FALLBACK=false
AD_TLS_REJECT_UNAUTHORIZED=true
# AD_TLS_CA_PATH=/run/certs/company-ca.crt

# Пароль PostgreSQL и секрет сессии создаются автоматически и хранятся
# вне Git. Не добавляйте сюда реальные пароли, SMTP-пароли и API-ключи.
#Рабочий .env
# Настройки SMTP и ИИ задаются администратором в интерфейсе сайта.
PORT=3000
PUBLIC_BASE_URL=http://10.27.26.27:3000
SESSION_SECRET=is1c-portfolio-secret-2024-change-me
DEFAULT_MANAGER_PASSWORD=Admin1234!

# PostgreSQL
PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=portfolio
PG_USER=postgres
PG_PASSWORD=Admin1234!
